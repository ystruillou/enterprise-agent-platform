{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Platform": {
    // Répertoire des fiches agents ; vide = recherche du dossier "agents" en remontant l'arborescence.
    "AgentsPath": "",
    // Force un fournisseur pour tous les agents (ex. "fake" en dev/CI). Vide = celui de chaque fiche.
    "ProviderOverride": "",
    "ModelOverride": ""
  },
  // Tous ces fournisseurs exposent une API compatible OpenAI.
  // Les clés ne sont JAMAIS ici : seulement le nom de la variable d'environnement (Secret Manager en prod).
  // Tarifs en USD par million de tokens : À VÉRIFIER sur les pages tarifs officielles avant toute décision.
  "Providers": {
    "fake": {
      "Prices": { "fake-model": { "InputPerMillion": 0.0, "OutputPerMillion": 0.0 } }
    },
    "gemini": {
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "ApiKeyEnv": "GEMINI_API_KEY",
      "Prices": { "gemini-2.5-flash": { "InputPerMillion": 0.30, "OutputPerMillion": 2.50 } }
    },
    "anthropic": {
      "Endpoint": "https://api.anthropic.com/v1/",
      "ApiKeyEnv": "ANTHROPIC_API_KEY",
      "Prices": { "claude-haiku-4-5": { "InputPerMillion": 1.00, "OutputPerMillion": 5.00 } }
    },
    "openai": {
      "Endpoint": "https://api.openai.com/v1/",
      "ApiKeyEnv": "OPENAI_API_KEY",
      "Prices": { "gpt-5-mini": { "InputPerMillion": 0.25, "OutputPerMillion": 2.00 } }
    },
    "qwen": {
      "Endpoint": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1/",
      "ApiKeyEnv": "DASHSCOPE_API_KEY",
      "Prices": { "qwen-plus": { "InputPerMillion": 0.40, "OutputPerMillion": 1.20 } }
    }
  }
}
