{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Platform": {
    // Répertoire des fiches agents ; vide = recherche du dossier "agents" en remontant l'arborescence.
    "AgentsPath": "",
    // Force un fournisseur pour tous les agents (ex. "fake" en dev/CI). Vide = celui de chaque fiche.
    "ProviderOverride": "",
    "ModelOverride": "",
    // Force le fournisseur d'embeddings de la recherche sémantique (ex. "fake"). Vide = celui de chaque fiche.
    "EmbeddingProviderOverride": ""
  },
  // Tous ces fournisseurs exposent une API compatible OpenAI.
  // Les clés ne sont JAMAIS ici : seulement le nom de la variable d'environnement (Secret Manager en prod).
  // Tarifs en USD par million de tokens : À VÉRIFIER sur les pages tarifs officielles avant toute décision.
  "Providers": {
    "fake": {
      "Prices": { "fake-model": { "InputPerMillion": 0.0, "OutputPerMillion": 0.0 } }
    },
    "gemini": {
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "ApiKeyEnv": "GEMINI_API_KEY",
      // Source : aistudio.google.com/docs/pricing, relevé le 2026-11-08 (gemini-2.5-flash est obsolète).
      // gemini-3.6-flash : tarif valable jusqu'au 31/12/2026, doublé à partir du 01/01/2027.
      "Prices": {
        "gemini-3.5-flash-lite": { "InputPerMillion": 0.30, "OutputPerMillion": 2.50 },
        "gemini-3.6-flash": { "InputPerMillion": 0.75, "OutputPerMillion": 3.75 }
      }
      // Embeddings (gemini-embedding-2) : la couche compatible OpenAI ne renvoie pas le nombre de tokens,
      // le coût n'est donc pas mesuré par appel (offre gratuite pendant le prototype).
    },
    "anthropic": {
      "Endpoint": "https://api.anthropic.com/v1/",
      "ApiKeyEnv": "ANTHROPIC_API_KEY",
      // Les modèles Claude récents refusent le paramètre temperature (HTTP 400).
      "SupportsTemperature": false,
      // Source : documentation Anthropic (relevé 2026-10). Haiku 5.5 : tarif pour prompts <= 100K tokens.
      "Prices": {
        "claude-haiku-5-5": { "InputPerMillion": 0.10, "OutputPerMillion": 0.50 },
        "claude-sonnet-5-5": { "InputPerMillion": 2.00, "OutputPerMillion": 10.00 }
      }
    },
    "openai": {
      "Endpoint": "https://api.openai.com/v1/",
      "ApiKeyEnv": "OPENAI_API_KEY",
      "Prices": { "gpt-5-mini": { "InputPerMillion": 0.25, "OutputPerMillion": 2.00 } }
    },
    "qwen": {
      "Endpoint": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1/",
      "ApiKeyEnv": "DASHSCOPE_API_KEY",
      "Prices": { "qwen-plus": { "InputPerMillion": 0.40, "OutputPerMillion": 1.20 } }
    }
  }
}
